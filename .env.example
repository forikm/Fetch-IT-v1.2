# Fetch-It Customer app — environment variables
# Copy this file to `.env` for local development, and add the same variables
# in Vercel → Project → Settings → Environment Variables for deployment.

# Shared Railway PostgreSQL instance (all three Fetch-It apps use this DB).
# Use the PUBLIC connection string from Railway, not the internal one.
DATABASE_URL=postgresql://user:password@host:port/railway

# Google Maps / Places key used for address autocomplete and route maps.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Public URL of the separate Fetch-It Rider PWA, used by the navigation link.
NEXT_PUBLIC_RIDER_APP_URL=https://fetch-it-rider.vercel.app/

# Firebase Console > Project settings > Your apps > Web app config.
# These web app values are public configuration, not secret keys.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id

# Firebase Console > Project settings > Service accounts > Generate new private key.
# Keep these on the server only. In Vercel, paste the private key as one value;
# escaped \n line breaks are supported.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Required in production: generate 32 random bytes (64 hex characters).
# Never use a sample value; missing or short secrets prevent sign-in.
SESSION_SECRET=

# Enable only after the Gmail sender and database migration have been configured.
# This boolean is public; the three credentials below are server-only.
NEXT_PUBLIC_EMAIL_CODE_AUTH=false
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
# Generate a separate random secret of at least 32 characters.
EMAIL_CODE_SECRET=

# Same random value in customer and rider deployments; do not rotate with active delivery codes.
DELIVERY_CODE_SECRET=

# Optional real support channels shown publicly on Help and Contact Us.
# Leave blank until the channel is staffed. These values are included at build time.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_HOURS=
